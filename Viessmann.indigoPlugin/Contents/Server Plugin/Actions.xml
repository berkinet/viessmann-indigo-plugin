<?xml version='1.0' encoding='utf-8'?>
<Actions>
  <Action id="requestStatus" deviceFilter="self">
    <Name>Request status</Name>
    <CallbackMethod>requestStatus</CallbackMethod>
  </Action>
  <Action id="selectRoomTarget" deviceFilter="self.viessmannHeater">
    <Name>Select room target to display/edit</Name>
    <CallbackMethod>selectRoomTarget</CallbackMethod>
    <ConfigUI>
      <Field id="target" type="menu" defaultValue="standard">
        <Label>Room target:</Label>
        <List>
          <Option value="standard">Standard / normal</Option>
          <Option value="reduced">Reduced</Option>
          <Option value="party">Party</Option>
        </List>
      </Field>
    </ConfigUI>
  </Action>
  <Action id="setHoliday" deviceFilter="self.viessmannSystem">
    <Name>Set holiday departure and return dates</Name>
    <CallbackMethod>setHoliday</CallbackMethod>
    <ConfigUI>
      <Field id="departure" type="textfield"><Label>Departure date (YYYY-MM-DD):</Label></Field>
      <Field id="returning" type="textfield"><Label>Return date (YYYY-MM-DD):</Label></Field>
      <Field id="holidayHelp" type="label"><Label>Heater-local travel dates. Holiday operation starts the day after departure and ends at midnight on return. Departure must be today or later, with at least one full day away. Requires live-write opt-in and a UTC vcontrold daemon. Both writes require acknowledgement and matching readback. Failure can leave a partial schedule; inspect the readback before retrying. Replacing an active holiday is not supported.</Label></Field>
    </ConfigUI>
  </Action>
  <Action id="clearHoliday" deviceFilter="self.viessmannSystem">
    <Name>Clear holiday dates</Name>
    <CallbackMethod>clearHoliday</CallbackMethod>
  </Action>
</Actions>