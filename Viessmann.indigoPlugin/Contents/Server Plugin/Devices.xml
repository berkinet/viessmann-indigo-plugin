<?xml version='1.0' encoding='utf-8'?>
<Devices>
  <Device id="viessmannSystem" type="custom">
    <Name>Viessmann system</Name>
    <ConfigUI>
      <Field id="host" type="textfield" defaultValue="">
        <Label>vcontrold host:</Label>
        <Description>Raspberry Pi hostname or IP address.</Description>
      </Field>
      <Field id="port" type="textfield" defaultValue="3002">
        <Label>TCP port:</Label>
      </Field>
      <Field id="pollInterval" type="textfield" defaultValue="180">
        <Label>Polling interval (seconds):</Label>
        <Description>30–86400 seconds after each cycle completes.</Description>
      </Field>
      <Field id="healthInterval" type="textfield" defaultValue="30">
        <Label>Controller health-check interval (seconds):</Label>
        <Description>10–86400 seconds. Reads the controller clock independently of full data polling.</Description>
      </Field>
      <Field id="faultInterval" type="textfield" defaultValue="60">
        <Label>Error/status sampling interval (seconds):</Label>
        <Description>10–86400 seconds. Samples error history and the provisional KO2B relay fault bit. History is retained after clearing; suspect replies do not clear the last fault.</Description>
      </Field>
      <Field id="timeout" type="textfield" defaultValue="12">
        <Label>Response timeout (seconds):</Label>
        <Description>1–60 seconds per command.</Description>
      </Field>
      <Field id="pollingEnabled" type="checkbox" defaultValue="false">
        <Label>Polling:</Label>
        <Description>Enable periodic readings and controller health checks. Live writes require separate plugin opt-in.</Description>
      </Field>
      <Field id="activityProbeEnabled" type="checkbox" defaultValue="true">
        <Label>Optical activity:</Label>
        <Description>On a failed clock check, listen for 0x05 as a fallback diagnostic (KW/KW2 only). Successful clock checks keep the optical link open.</Description>
      </Field>
      <Field id="SupportsStatusRequest" type="checkbox" defaultValue="true" hidden="true" />
    </ConfigUI>
    <States>
      <State id="productionFault"><ValueType>Boolean</ValueType><TriggerLabel>Production fault flag</TriggerLabel><ControlPageLabel>Production fault flag</ControlPageLabel></State>
      <State id="productionHardBlock"><ValueType>Boolean</ValueType><TriggerLabel>Production hard block — not verified burner lockout</TriggerLabel><ControlPageLabel>Production hard block — not verified burner lockout</ControlPageLabel></State>
      <State id="productionSpecialOperation"><ValueType>Boolean</ValueType><TriggerLabel>Production special operation</TriggerLabel><ControlPageLabel>Production special operation</ControlPageLabel></State>
      <State id="productionStorageCharging"><ValueType>Boolean</ValueType><TriggerLabel>Production storage charging</TriggerLabel><ControlPageLabel>Production storage charging</ControlPageLabel></State>
      <State id="productionStatusValid"><ValueType>Boolean</ValueType><TriggerLabel>Production status reading valid</TriggerLabel><ControlPageLabel>Production status reading valid</ControlPageLabel></State>
      <State id="productionStatusRaw"><ValueType>String</ValueType><TriggerLabel>Production status raw four bytes</TriggerLabel><ControlPageLabel>Production status raw four bytes</ControlPageLabel></State>
      <State id="productionStatusUpdated"><ValueType>String</ValueType><TriggerLabel>Production status last success (UTC)</TriggerLabel><ControlPageLabel>Production status last success (UTC)</ControlPageLabel></State>
      <State id="productionStatusError"><ValueType>String</ValueType><TriggerLabel>Production status read error</TriggerLabel><ControlPageLabel>Production status read error</ControlPageLabel></State>
      <State id="burnerOutput"><ValueType>Number</ValueType><TriggerLabel>Burner output (%) — provisional</TriggerLabel><ControlPageLabel>Burner output (%) — provisional</ControlPageLabel></State>
      <State id="burnerOutputStatus"><ValueType>Number</ValueType><TriggerLabel>Burner output status byte — provisional</TriggerLabel><ControlPageLabel>Burner output status byte — provisional</ControlPageLabel></State>
      <State id="burnerOutputValid"><ValueType>Boolean</ValueType><TriggerLabel>Burner output reading valid</TriggerLabel><ControlPageLabel>Burner output reading valid</ControlPageLabel></State>
      <State id="burnerOutputUpdated"><ValueType>String</ValueType><TriggerLabel>Burner output last success (UTC)</TriggerLabel><ControlPageLabel>Burner output last success (UTC)</ControlPageLabel></State>
      <State id="burnerOutputRaw"><ValueType>String</ValueType><TriggerLabel>Burner output raw daemon response</TriggerLabel><ControlPageLabel>Burner output raw daemon response</ControlPageLabel></State>
      <State id="burnerOutputError"><ValueType>String</ValueType><TriggerLabel>Burner output read error</TriggerLabel><ControlPageLabel>Burner output read error</ControlPageLabel></State>

      <State id="burnerActive"><ValueType>Boolean</ValueType><TriggerLabel>Burner active</TriggerLabel><ControlPageLabel>Burner active</ControlPageLabel></State>
      <State id="burnerStatusValid"><ValueType>Boolean</ValueType><TriggerLabel>Burner activity reading valid</TriggerLabel><ControlPageLabel>Burner activity reading valid</ControlPageLabel></State>
