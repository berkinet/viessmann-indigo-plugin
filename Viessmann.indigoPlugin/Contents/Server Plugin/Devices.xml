      <State id="status">
        <ValueType>String</ValueType>
        <TriggerLabel>Status</TriggerLabel>
        <ControlPageLabel>Status</ControlPageLabel>
      </State>
      <State id="lastAttempt">
        <ValueType>String</ValueType>
        <TriggerLabel>Last attempt (UTC)</TriggerLabel>
        <ControlPageLabel>Last attempt (UTC)</ControlPageLabel>
      </State>
      <State id="lastSuccess">
        <ValueType>String</ValueType>
        <TriggerLabel>Last complete success (UTC)</TriggerLabel>
