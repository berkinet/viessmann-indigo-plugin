        <ControlPageLabel>TCP available at last attempt</ControlPageLabel>
      </State>
      <State id="boilerTemp">
        <ValueType>Number</ValueType>
        <TriggerLabel>Boiler temperature (C)</TriggerLabel>
        <ControlPageLabel>Boiler temperature (C)</ControlPageLabel>
      </State>
      <State id="boilerTempValid">
        <ValueType>Boolean</ValueType>
        <TriggerLabel>Boiler temperature valid</TriggerLabel>
        <ControlPageLabel>Boiler temperature valid</ControlPageLabel>
      </State>
      <State id="boilerTempUpdated">
        <ValueType>String</ValueType>
        <TriggerLabel>Boiler temperature last success (UTC)</TriggerLabel>
        <ControlPageLabel>Boiler temperature last success (UTC)</ControlPageLabel>
      </State>
      <State id="outsideTemp">
        <ValueType>Number</ValueType>
        <TriggerLabel>Outside temperature (C)</TriggerLabel>
        <ControlPageLabel>Outside temperature (C)</ControlPageLabel>
      </State>
      <State id="outsideTempValid">
        <ValueType>Boolean</ValueType>
        <TriggerLabel>Outside temperature valid</TriggerLabel>
        <ControlPageLabel>Outside temperature valid</ControlPageLabel>
      </State>
      <State id="outsideTempUpdated">
        <ValueType>String</ValueType>
        <TriggerLabel>Outside temperature last success (UTC)</TriggerLabel>
        <ControlPageLabel>Outside temperature last success (UTC)</ControlPageLabel>
      </State>
      <State id="simulator">
        <ValueType>Boolean</ValueType>
        <TriggerLabel>Simulator endpoint</TriggerLabel>
        <ControlPageLabel>Simulator endpoint</ControlPageLabel>
      </State>
      <State id="opticalActivity">
        <ValueType>String</ValueType>
        <TriggerLabel>Optical activity at last attempt</TriggerLabel>
        <ControlPageLabel>Optical activity at last attempt</ControlPageLabel>
      </State>
