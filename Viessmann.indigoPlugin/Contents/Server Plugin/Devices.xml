      <State id="burnerStatusUpdated"><ValueType>String</ValueType><TriggerLabel>Burner activity last success (UTC)</TriggerLabel><ControlPageLabel>Burner activity last success (UTC)</ControlPageLabel></State>

      <State id="lastRecordedError"><ValueType>String</ValueType><TriggerLabel>Last recorded error (history)</TriggerLabel><ControlPageLabel>Last recorded error (history)</ControlPageLabel></State>
      <State id="relayStatusRaw"><ValueType>String</ValueType><TriggerLabel>Raw relay status</TriggerLabel><ControlPageLabel>Raw relay status</ControlPageLabel></State>
      <State id="lastFaultCheck"><ValueType>String</ValueType><TriggerLabel>Last fault sample (UTC)</TriggerLabel><ControlPageLabel>Last fault sample (UTC)</ControlPageLabel></State>
      <State id="faultStatus"><ValueType>String</ValueType><TriggerLabel>Current fault interpretation</TriggerLabel><ControlPageLabel>Current fault interpretation</ControlPageLabel></State>
