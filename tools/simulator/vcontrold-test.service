[Unit]
Description=Viessmann TEST vcontrold using synthetic simulator, no physical heater
Requires=vcontrold-simulator.service
After=vcontrold-simulator.service

[Service]
Type=forking
PIDFile=/home/rdp/viessmann/simulator/vcontrold-test.pid
User=rdp
WorkingDirectory=/home/rdp/viessmann/simulator
ExecStart=/usr/local/sbin/vcontrold -x /home/rdp/viessmann/simulator/config/vcontrold.xml -d 127.0.0.1:6578 -p 3002 -L 192.168.5.37 -l /home/rdp/viessmann/simulator/vcontrold-test.log -P /home/rdp/viessmann/simulator/vcontrold-test.pid
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rdp/viessmann/simulator
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=192.168.5.0/24

[Install]
WantedBy=multi-user.target
